  "lines": {
    "L01": {
      "start": 1.2,
      "end": 3.45,
      "speaker": "narrator",
      "text": "Every industrial site changes by the hour."
    },
    "L02": {
      "start": 3.84,
      "end": 7.58,
      "speaker": "narrator",
      "text": "Contractors arrive. Equipment is isolated. Work moves."
    },
    "L03": {
      "start": 8.22,
      "end": 10.87,
      "speaker": "narrator",
      "text": "Insurance sets conditions under which risk is accepted."
    },
    "L04": {
      "start": 11.13,
      "end": 13.98,
      "speaker": "narrator",
      "text": "Good teams translate them into permits, briefings and checklists."
    },
    "L05": {
      "start": 14.48,
      "end": 16.6,
      "speaker": "narrator",
      "text": "But no one can hold a moving site in their head."
    },
    "L06": {
      "start": 17.2,
      "end": 21.33,
      "speaker": "narrator",
      "text": "On Roof 03, hot work begins. The certificate and safeguards are in place."
    },
    "L07": {
      "start": 21.78,
      "end": 23.48,
      "speaker": "narrator",
      "text": "Then a sprinkler zone goes offline."
    },
    "L08": {
      "start": 24.38,
      "end": 29.67,
      "speaker": "narrator",
      "text": "Nothing looks different. Work continues. But the conditions have changed, and nobody sees it."
    },
    "L09": {
      "start": 30.37,
      "end": 32.72,
      "speaker": "narrator",
      "text": "If something goes wrong, questions begin afterwards:"
    },
    "L10": {
      "start": 32.92,
      "end": 37.03,
      "speaker": "narrator",
      "text": "What was happening? Which condition applied? Can you prove what was true?"
    },
    "L11": {
      "start": 37.67,
      "end": 39.75,
      "speaker": "narrator",
      "text": "Today, the gap is often discovered too late."
    },
    "L12": {
      "start": 43.85,
      "end": 46.11,
      "speaker": "narrator",
      "text": "What if the decision existed when the risk changed?"
    },
    "L13": {
      "start": 46.81,
      "end": 49.2,
      "speaker": "worker",
      "text": "I'm welding on Roof 03 until six."
    },
    "L14": {
      "start": 49.76,
      "end": 56.49,
      "speaker": "narrator",
      "text": "Priora connects the activity to the conditions that matter, verifies the certificate and safeguards, and creates the record while work happens."
    },
    "L15": {
      "start": 56.84,
      "end": 59.64,
      "speaker": "narrator",
      "text": "Prevention before the work. Proof as it happens."
    },
    "L16": {
      "start": 60.83,
      "end": 63.89,
      "speaker": "narrator",
      "text": "When the sprinkler goes offline again, Priora sees it immediately."
    },
    "L17": {
      "start": 65.09,
      "end": 71.99,
      "speaker": "narrator",
      "text": "Now the risk owner can change the activity, knowingly retain the exposure, or eventually ask selected carriers whether they will cover it."
    },
    "L18": {
      "start": 72.59,
      "end": 76.64,
      "speaker": "narrator",
      "text": "Most work remains ordinary. A few changes become explicit decisions."
    },
    "L19a": {
      "start": 77.24,
      "end": 78.52,
      "speaker": "narrator",
      "text": "Record becomes trust."
    },
    "L19b": {
      "start": 78.82,
      "end": 80.18,
      "speaker": "narrator",
      "text": "Trust enables decisions."
    },
    "L19c": {
      "start": 80.48,
      "end": 81.89,
      "speaker": "narrator",
      "text": "Decisions can carry price."
    },
    "L19d": {
      "start": 82.19,
      "end": 83.68,
      "speaker": "narrator",
      "text": "Price can connect to capacity."
    },
    "L20": {
      "start": 84.48,
      "end": 88.1,
      "speaker": "narrator",
      "text": "Priora. Infrastructure for activity-level physical risk."
    }
  },
