  "lines": {
    "L01": {
      "start": 0.8,
      "end": 3.33,
      "speaker": "narrator",
      "text": "Every industrial site changes by the hour."
    },
    "L02": {
      "start": 3.67,
      "end": 7.74,
      "speaker": "narrator",
      "text": "Contractors arrive. Equipment is isolated. Work moves."
    },
    "L03": {
      "start": 8.17,
      "end": 11.1,
      "speaker": "narrator",
      "text": "Insurance sets conditions under which risk is accepted."
    },
    "L04": {
      "start": 11.3,
      "end": 14.41,
      "speaker": "narrator",
      "text": "Good teams translate them into permits, briefings and checklists."
    },
    "L05": {
      "start": 14.76,
      "end": 16.89,
      "speaker": "narrator",
      "text": "But no one can hold a moving site in mind."
    },
    "L06": {
      "start": 17.29,
      "end": 20.49,
      "speaker": "narrator",
      "text": "On Roof 03, hot work begins, every safeguard in place."
    },
    "L07": {
      "start": 20.94,
      "end": 22.78,
      "speaker": "narrator",
      "text": "Then a sprinkler zone goes offline."
    },
    "L08": {
      "start": 23.98,
      "end": 27.96,
      "speaker": "narrator",
      "text": "Nothing looks different. The conditions have changed, and nobody sees it."
    },
    "L09": {
      "start": 28.96,
      "end": 31.4,
      "speaker": "narrator",
      "text": "If something goes wrong, questions begin afterwards:"
    },
    "L10": {
      "start": 31.6,
      "end": 35.83,
      "speaker": "narrator",
      "text": "What was happening? Which condition applied? Can you prove what was true?"
    },
    "L11": {
      "start": 36.37,
      "end": 38.66,
      "speaker": "narrator",
      "text": "Today, the gap is often discovered too late."
    },
    "L12": {
      "start": 42.66,
      "end": 45.21,
      "speaker": "narrator",
      "text": "What if the decision existed when the risk changed?"
    },
    "L13": {
      "start": 45.81,
      "end": 48.2,
      "speaker": "worker",
      "text": "I'm welding on Roof 03 until six."
    },
    "L14a": {
      "start": 48.71,
      "end": 51.36,
      "speaker": "narrator",
      "text": "Priora connects the work to the conditions that matter."
    },
    "L14b": {
      "start": 52.18,
      "end": 55.26,
      "speaker": "narrator",
      "text": "It checks the certificate and safeguards, and keeps the record."
    },
    "L15": {
      "start": 55.61,
      "end": 58.55,
      "speaker": "narrator",
      "text": "Prevention before the work. Proof as it happens."
    },
    "L16": {
      "start": 59.55,
      "end": 63.47,
      "speaker": "narrator",
      "text": "The sprinkler goes offline again. This time, Priora sees it at once."
    },
    "L17": {
      "start": 64.87,
      "end": 71.18,
      "speaker": "narrator",
      "text": "The risk owner decides: change the work, knowingly retain the risk, or, in time, ask selected carriers to cover it."
    },
    "L18": {
      "start": 71.68,
      "end": 75.99,
      "speaker": "narrator",
      "text": "Most work remains ordinary. A few changes become explicit decisions."
    },
    "L19a": {
      "start": 76.49,
      "end": 77.83,
      "speaker": "narrator",
      "text": "Record becomes trust."
    },
    "L19b": {
      "start": 78.13,
      "end": 79.62,
      "speaker": "narrator",
      "text": "Trust enables decisions."
    },
    "L19c": {
      "start": 79.92,
      "end": 81.5,
      "speaker": "narrator",
      "text": "Decisions can carry price."
    },
    "L19d": {
      "start": 81.8,
      "end": 83.47,
      "speaker": "narrator",
      "text": "Price can connect to capacity."
    },
    "L20": {
      "start": 84.17,
      "end": 88.02,
      "speaker": "narrator",
      "text": "Priora. Infrastructure for activity-level physical risk."
    }
  },
